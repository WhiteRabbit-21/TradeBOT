# Trading policy v2
# 1 = accept SCALP, INTRADAY and SWING signal headers.
TRADE_LONG_ALL_STYLES=1

# 1 = reject every new SHORT entry. Position management remains active.
TRADE_LONG_ONLY=1

# 1 = open ordinary crypto assets only. Stock/ETF/TradFi signals are still
# retained by the signal generator for research, but no new order is opened.
TRADE_CRYPTO_ONLY=1

# 1 = allow SWING LONG during the blocked SCALP/INTRADAY window.
ALLOW_SWING_LONG_DURING_BLOCKED_HOURS=1

# Block SCALP/INTRADAY entries from 00:00 inclusive until 06:00 exclusive,
# Europe/Kyiv. SWING LONG bypasses this window when the flag above is 1.
ENTRY_BLOCK_START_HOUR_KYIV=0
ENTRY_BLOCK_END_HOUR_KYIV=6

# SCALP/INTRADAY close 100% at TP1. SWING uses 40%/30%/30% at TP1/TP2/TP3.
# There is intentionally no minimum RR.
# Full-TP1 styles require effective RR1 < 3.0; SCALP is stricter at RR1 < 2.5.
# The cap does not apply to SWING because it closes only 40% at TP1.
FULL_TP1_MAX_RR_EXCLUSIVE=3.0
SCALP_FULL_TP1_MAX_RR_EXCLUSIVE=2.5

# Poll actual SWING position size and move/resize its SL after partial fills.
SWING_EXIT_WATCH_SEC=4

# Risk/execution defaults.
# SWING is fixed at 0.5% in trade_rules.py; this fallback currently applies to
# the other styles and remains 0.5% unless their separate rules are changed.
FIXED_RISK_PCT=0.5
DRY_RUN=1

# Optional: keep an unconfigured template service alive instead of restarting.
WAIT_FOR_CONFIG=0
