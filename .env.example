# Active styles are fixed in trade_rules.py and cannot be overridden by stale
# Railway variables. Rule 2A - Scalping: SCALP LONG, every BingX-listed asset,
# TP1 RR in [0.80, 1.00), 40/30/30 at TP1/TP2/TP3, Entry - 0.05R protection
# after TP1, 0.5% current-equity risk per trade.
# Rule 1 - Swing: SWING LONG, ordinary crypto, 40/30/30 at TP1/TP2/TP3,
# Entry - 0.08R protection after TP1, 0.5% current-equity risk per trade.
# Position additions/DCA are disabled so that risk is not increased after the
# entry. There is intentionally no global concurrent-position count; a repeat
# signal for the same symbol/side is skipped because BingX would aggregate it.

# Block Rule 2 SCALP entries from 00:00 inclusive until 06:00 exclusive,
# Europe/Kyiv. Rule 1 SWING and existing position management remain active.
ENTRY_BLOCK_START_HOUR_KYIV=0
ENTRY_BLOCK_END_HOUR_KYIV=6

# Rule 1 - Swing: poll positions and move/resize their SL after partial fills.
SWING_EXIT_WATCH_SEC=4

# Reject a delayed LONG entry after price moves more than 0.25 of the
# originally planned Entry-to-SL risk distance above the signal Entry.
SWING_MAX_ENTRY_DRIFT_R=0.25

# Execution mode. Risk is fixed at 0.5% in trade_rules.py.
DRY_RUN=1

# Optional: keep an unconfigured template service alive instead of restarting.
WAIT_FOR_CONFIG=0
